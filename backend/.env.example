# Copy to .env and fill in. Never commit the filled-in file.

# Postgres connection string (Neon). Used by Prisma.
DATABASE_URL=

# Secret used to sign and verify the SIWE session JWT. Any long random string.
JWT_SECRET=

# Ethereum Sepolia JSON-RPC endpoint (Alchemy, Infura, or a public node).
RPC_URL=

# Private key of the wallet that receives task funding and pays out rewards.
# Use a throwaway Sepolia wallet — this key can move real funds on that chain.
SERVER_PRIVATE_KEY=

# Pinata JWT for pinning option images to IPFS.
PINATA_JWT=

# Port the Express server listens on. Defaults to 4000 if unset.
PORT=

# Max accepted upload size in megabytes. Defaults to 5 if unset.
MAX_UPLOAD_MB=

# Comma-separated MIME allowlist for uploads.
# Defaults to image/jpeg,image/png,image/webp if unset.
ALLOWED_MIMES=

# Comma-separated browser origins allowed to call this API, e.g. the deployed
# frontend URL. localhost:3000 and :3001 are always allowed on top of these.
ALLOWED_ORIGINS=
