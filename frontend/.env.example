# Copy to .env.local and fill in. Never commit the filled-in file.
# Everything here is NEXT_PUBLIC_ and therefore shipped to the browser —
# put no secrets in this file.

# Base URL of the Clixo backend, including the /api prefix.
# Defaults to http://localhost:4000/api if unset.
NEXT_PUBLIC_API_BASE_URL=

# Address of the server wallet task funding is sent to. Must match the wallet
# behind the backend's SERVER_PRIVATE_KEY.
NEXT_PUBLIC_SERVER_WALLET_ADDRESS=

# WalletConnect Cloud project id, for the RainbowKit connector list.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Public origin of the deployed site, used to resolve OG and canonical URLs.
# Falls back to the Vercel deployment URL, then to localhost.
NEXT_PUBLIC_SITE_URL=
